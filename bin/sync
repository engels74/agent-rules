#!/usr/bin/env bash
# bin/sync — hydrate canonical agent rules into local checkouts.
#
# Rules are NEVER committed into a consumer repo. All three accounts are
# mutually isolated, so hydration must leave no public artifact:
#   * files are written to the worktree, then excluded via .git/info/exclude
#     (uncommitted, unlike .gitignore — a shared ignore line is itself a
#     weak cross-account fingerprint)
#   * files already tracked are de-published with `git rm --cached`
#   * legacy filenames are pruned in the same pass, so no repo is ever left
#     holding two contradictory rule files
#
# This script NEVER commits and NEVER pushes. It stages removals and leaves
# them for you to review and push per-repo, where includeIf picks the identity.
#
#   bin/sync                 dry run over every repo   (default)
#   bin/sync --apply         act
#   bin/sync <slug> ...      limit to specific slugs
set -euo pipefail

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  echo "bin/sync needs bash >= 4 (found $BASH_VERSION)." >&2
  echo "macOS ships bash 3.2; run under Homebrew bash: brew install bash" >&2
  exit 1
fi

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="${AGENT_RULES_ROOT:-$HOME/Documents/GitHub}"
APPLY=0; FILTER=()
LOCAL_MANIFEST=""
[ -f "$HERE/manifest.local.toml" ] && LOCAL_MANIFEST="$HERE/manifest.local.toml"
for a in "$@"; do
  case "$a" in
    --apply) APPLY=1 ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown flag: $a" >&2; exit 2 ;;
    *) FILTER+=("$a") ;;
  esac
done

red(){ printf '\033[31m%s\033[0m\n' "$*"; }
grn(){ printf '\033[32m%s\033[0m\n' "$*"; }
ylw(){ printf '\033[33m%s\033[0m\n' "$*"; }

# ---- discover checkouts by ORIGIN SLUG, never by directory name -------------
# Local paths do not match slugs (afisharr-project/afisharr, poyo-local), and a
# single slug may have several checkouts. Both must hydrate.
declare -a SLUGS PATHS
while IFS= read -r gitdir; do
  wt="$(dirname "$gitdir")"
  url="$(git -C "$wt" remote get-url origin 2>/dev/null || true)"
  [ -n "$url" ] || continue
  # handles both git@github.com-alias:owner/repo.git and https://github.com/owner/repo
  slug="$(printf '%s' "${url%.git}" | awk -F'[:/]' '{print $(NF-1)"/"$NF}')"
  SLUGS+=("$slug"); PATHS+=("$wt")
done < <(find "$ROOT" -maxdepth 4 -name .git -type d -not -path '*/node_modules/*' 2>/dev/null)

paths_for(){ local q="$1" i; for i in "${!SLUGS[@]}"; do
  [ "${SLUGS[$i]}" = "$q" ] && printf '%s\n' "${PATHS[$i]}"; done; }

# ---- parse manifest ---------------------------------------------------------
parse(){ awk '
  # collect the quoted values on a line: "a", "b" -> a b
  function q(line,   out,n,i,arr) {
    out=""; n=split(line, arr, "\"")
    for (i=2; i<=n; i+=2) out = out (out=="" ? "" : " ") arr[i]
    return out
  }
  /^\[\[repo\]\]/        { if(s!="") print s"|"r"|"ar"|"nx"|"pb; s=""; r=""; ar="false"; nx="false"; pb="false"; next }
  /^[[:space:]]*slug/     { s=q($0);  next }
  /^[[:space:]]*rules/    { r=q($0);  next }
  /^[[:space:]]*archived/ { ar="true"; next }
  /^[[:space:]]*nested/   { nx="true"; next }
  /^[[:space:]]*publish/  { pb=($0 ~ /true/) ? "true" : "false"; next }
  END                     { if(s!="") print s"|"r"|"ar"|"nx"|"pb }
' "$HERE/manifest.toml" ${LOCAL_MANIFEST:+"$LOCAL_MANIFEST"}; }

fail=0; touched=0
while IFS='|' read -r slug rules archived nested publish; do
  [ -n "$slug" ] || continue
  if [ ${#FILTER[@]} -gt 0 ]; then
    match=0; for f in "${FILTER[@]}"; do [ "$f" = "$slug" ] && match=1; done
    [ $match -eq 1 ] || continue
  fi

  mapfile -t wts < <(paths_for "$slug")
  if [ ${#wts[@]} -eq 0 ]; then ylw "SKIP  $slug — no local checkout"; continue; fi

  for wt in "${wts[@]}"; do
    label="$slug"; [ ${#wts[@]} -gt 1 ] && label="$slug [$(basename "$wt")]"
    echo "── $label"

    if [ "$archived" = "true" ]; then
      ylw "   archived — read-only, no writes attempted"
      for f in "$wt"/.agents/rules/*.md; do [ -e "$f" ] && \
        red "   STUCK  $(basename "$f") is public and cannot be pruned"; done
      continue
    fi

    # desired set
    declare -A want=(); for r in $rules; do [ -n "$r" ] && want["$r.md"]=1; done
    dir="$wt/.agents/rules"

    # 1. de-publish anything tracked (must precede exclusion — git ignores
    #    exclude rules for already-tracked paths). Skipped when publishing.
    while IFS= read -r tracked; do
      [ "$publish" = "true" ] && continue
      [ -n "$tracked" ] || continue
      red "   DEPUBLISH  $tracked (tracked → staged for removal)"
      touched=1
      [ $APPLY -eq 1 ] && git -C "$wt" rm --cached --quiet "$tracked"
    done < <(if [ "$nested" = "true" ]; then
               git -C "$wt" ls-files '*.agents/rules/*.md' 2>/dev/null
             else
               git -C "$wt" ls-files '.agents/rules/*.md' 2>/dev/null
             fi)

    # 2. prune anything not wanted
    prune_scan(){ if [ "$nested" = "true" ]
        then find "$wt" -path '*/.agents/rules/*.md' -not -path '*/node_modules/*' 2>/dev/null
        else ls "$dir"/*.md 2>/dev/null; fi; }
    while IFS= read -r f; do
      [ -e "$f" ] || continue; b="$(basename "$f")"
      [ -n "${want[$b]:-}" ] && continue
      ylw "   PRUNE      ${f#$wt/}"; touched=1
      [ $APPLY -eq 1 ] && rm -f "$f"
    done < <(prune_scan)

    # 3. hydrate + verify
    for b in "${!want[@]}"; do
      src="$HERE/rules/$b"
      [ -f "$src" ] || { red "   MISSING    rules/$b"; fail=1; continue; }
      if [ -f "$dir/$b" ] && cmp -s "$src" "$dir/$b"; then
        grn "   ok         $b"; continue
      fi
      echo "   WRITE      $b"; touched=1
      [ $APPLY -eq 1 ] || continue
      mkdir -p "$dir"; cp "$src" "$dir/$b"
      # never trust the copy
      if [ "$(shasum -a 256 <"$src" | cut -d' ' -f1)" \
         != "$(shasum -a 256 <"$dir/$b" | cut -d' ' -f1)" ]; then
        red "   CHECKSUM MISMATCH after write: $b"; fail=1
      fi
    done

    # 4. publish: stage adds + deletions, and lift any stale exclusion
    #    (git add refuses an excluded path, so the line must go first)
    if [ $APPLY -eq 1 ] && [ "$publish" = "true" ]; then
      ex="$(git -C "$wt" rev-parse --git-dir)/info/exclude"
      if grep -qxF '.agents/rules/' "$ex" 2>/dev/null; then
        grep -vxF '.agents/rules/' "$ex" >"$ex.tmp" && mv "$ex.tmp" "$ex"
      fi
      git -C "$wt" add -A .agents/rules 2>/dev/null || true
      grn "   staged     .agents/rules (publish=true)"
    fi

    # 4b. do-not-publish: exclude via .git/info/exclude — no committed artifact
    if [ $APPLY -eq 1 ] && [ "$publish" != "true" ]; then
      ex="$(git -C "$wt" rev-parse --git-dir)/info/exclude"
      grep -qxF '.agents/rules/' "$ex" 2>/dev/null || {
        mkdir -p "$(dirname "$ex")"; printf '.agents/rules/\n' >>"$ex"; }
      # 5. assert the guard actually holds — a stray `git add -A` must not leak
      for b in "${!want[@]}"; do
        git -C "$wt" check-ignore -q ".agents/rules/$b" || {
          red "   LEAK RISK  .agents/rules/$b is NOT ignored"; fail=1; }
      done
    fi
    unset want
  done
done < <(parse)

echo
[ $APPLY -eq 1 ] || { [ $touched -eq 1 ] && ylw "dry run — re-run with --apply"; }
[ $APPLY -eq 1 ] && [ $touched -eq 1 ] && \
  ylw "staged removals are NOT committed. Review and push per repo."
[ $fail -eq 0 ] || { red "completed with errors"; exit 1; }
